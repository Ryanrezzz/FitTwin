# ──────────────────────────────────────────────────────────────
# FitTwin — environment template. Copy to .env and fill in.
# ──────────────────────────────────────────────────────────────

# App
APP_ENV=dev                      # dev | prod
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000  # comma-separated allow-list
AGENT_RECURSION_LIMIT=25         # safety cap on the LangGraph loop

# Database (MongoDB)
DB_ENABLED=true                  # false → run API offline (agent core only; auth/profile 503)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=fittwin
MONGO_TIMEOUT_MS=2000            # fail fast if Mongo is unreachable

# Cache / rate-limit (optional in V1)
REDIS_URI=redis://redis:6379/0

# Google Sign-In (optional — leave blank to disable; the button then hides)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:5173  (add your prod origin)
# This value is PUBLIC (it ships to the browser) — it is not a secret.
# Only the `email` + `profile` scopes are used, which need no Google review.
GOOGLE_CLIENT_ID=

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# LLM provider — pick one: fake | gemini | openai | ollama
# Defaults to `fake` so a fresh clone runs with NO API key: the agent core is
# fully deterministic and every LLM call already falls back to it on error.
# Switch to a real provider and set the matching key below.
#   gemini -> LLM_MODEL=gemini-2.5-flash   (2.0-flash may have quota 0 on free tier)
#   openai -> LLM_MODEL=gpt-4o-mini, or a gpt-5.x model. NOTE: gpt-5.5 and
#             gpt-5.6-* reject any temperature but the default — set LLM_SEED
#             instead, or output varies between identical runs.
LLM_PROVIDER=fake
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Reproducibility for providers that ignore temperature (see note above).
LLM_SEED=42

# Observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fittwin-dev
SENTRY_DSN=

# Frontend (Vite) — prefix VITE_ to expose to the browser
VITE_API_BASE_URL=http://localhost:8000
